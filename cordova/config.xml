<?xml version='1.0' encoding='utf-8'?>
<widget id="com.vue3frontdemo.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Vue3 Front Demo</name>
    <description>A Vue 3 + TypeScript + Vite application</description>
    <author email="dev@example.com" href="https://example.com">
        Developer
    </author>
    <content src="/" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
</widget>
