{
  "name": "vue3-front-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:electron": "pnpm run build && ncp electron dist && electron-packager dist Vue3FrontDemo --platform=win32 --arch=x64 --out=release --overwrite --icon=public/vite.svg",
    "build:capacitor-android": "pnpm run build && npx cap add android && npx cap copy",
    "sync-capacitor-android": "pnpm run build && npx cap sync",
    "open-capacitor-android": "npx cap open android",
    "preview": "vite preview",
    "lint": "npx eslint .",
    "prettier": "prettier --write src/**/*.{js,ts,tsx,vue}"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.14.3",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.27.1",
    "@eslint/js": "^9.26.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^41.2.0",
    "electron-packager": "^17.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "ncp": "^2.0.0",
    "prettier": "^3.5.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^8.0.7",
    "vite-plugin-eslint": "^1.8.1",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
